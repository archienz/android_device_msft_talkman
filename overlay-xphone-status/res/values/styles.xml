<resources>
    <style name="TextAppearance.StatusBar.Clock" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/status_bar_clock_size</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
