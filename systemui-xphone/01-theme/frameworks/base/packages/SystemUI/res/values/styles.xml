<?xml version="1.0" encoding="utf-8"?>
<!--
     talkman SystemUI overlay — X-phone type.
     Clock sans-serif-thin. All-caps tracked labels.
     Full style bodies (overlay replaces the named style).
     Names from frameworks/base/packages/SystemUI/res/values/styles.xml.
     Do not overlay TextAppearance.Keyguard.
-->
<resources>
    <style name="TextAppearance.StatusBar.Clock" parent="@*android:style/TextAppearance.StatusBar.Icon">
        <item name="android:textSize">@dimen/status_bar_clock_size</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textColor">@color/status_bar_clock_color</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.StatusBar.Expanded.Clock">
        <item name="android:textSize">@dimen/qs_time_expanded_size</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.QS.Subhead">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/qs_subhead</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
    </style>

    <style name="TextAppearance.QS.TileLabel">
        <item name="android:textSize">@dimen/qs_tile_text_size</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamily</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.QS.Status" parent="TextAppearance.QS.TileLabel.Secondary">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/dark_mode_qs_icon_color_single_tone</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
    </style>

    <style name="TextAppearance.QSEdit.Headers"
            parent="@*android:style/TextAppearance.DeviceDefault.Body2">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.NotificationSectionHeaderButton"
            parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/notification_section_header_label_color</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- Void chrome. Stock QuickSettings is a light theme; force dark so
         tiles are not black-on-black once the slab is void. -->
    <style name="Theme.SystemUI" parent="@*android:style/Theme.DeviceDefault.QuickSettings">
        <item name="lightIconTheme">@style/DualToneLightTheme</item>
        <item name="darkIconTheme">@style/DualToneDarkTheme</item>
        <item name="wallpaperTextColor">@*android:color/primary_text_material_dark</item>
        <item name="wallpaperTextColorSecondary">@*android:color/secondary_text_material_dark</item>
        <item name="android:colorError">@*android:color/error_color_material_dark</item>
        <item name="android:colorControlHighlight">@*android:color/primary_text_material_dark</item>
        <item name="*android:lockPatternStyle">@style/LockPatternStyle</item>
        <item name="passwordStyle">@style/PasswordTheme</item>
        <item name="backgroundProtectedStyle">@style/BackgroundProtectedStyle</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_arrow_back</item>
        <item name="shadowRadius">@dimen/keyguard_shadow_radius</item>
        <item name="*android:isLightTheme">false</item>
        <item name="android:colorAccent">#ffe8e8e8</item>
        <item name="android:colorBackground">#ff000000</item>
        <item name="android:colorBackgroundFloating">#ff000000</item>
    </style>

    <style name="qs_theme" parent="@*android:style/Theme.DeviceDefault.QuickSettings">
        <item name="lightIconTheme">@style/QSIconTheme</item>
        <item name="darkIconTheme">@style/QSIconTheme</item>
        <item name="android:colorError">@*android:color/error_color_material_dark</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_arrow_back</item>
        <item name="android:colorAccent">#ffe8e8e8</item>
        <item name="android:colorPrimary">#ff000000</item>
        <item name="android:colorBackground">#ff000000</item>
        <item name="android:colorBackgroundFloating">#ff000000</item>
        <item name="android:textColorPrimary">#ffe8e8e8</item>
        <item name="android:textColorSecondary">#99e8e8e8</item>
        <item name="android:textColorTertiary">#ff111111</item>
        <item name="android:textColorHint">#66e8e8e8</item>
        <item name="*android:isLightTheme">false</item>
    </style>
</resources>
