# qpnp-* suffix is an SPMI IDA id (spmi_add_device), not a DT unit address.
# Talkman nodes: qcom,qpnp-smbcharger, qcom,qpnp-fg (mmo charger.dtsi / pmi8994).
# Health 2.1 requires sysfs_batteryinfo on every power_supply file it reads.
# Class path is a symlink; BatteryMonitor follows it to the real kobj (bms/battery).
genfscon sysfs /class/power_supply                                       u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/soc.0/qpnp-smbcharger                            u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/soc.0/qpnp-fg                                    u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/soc.0/f9200000.ssusb/power_supply                u:object_r:sysfs_batteryinfo:s0
# Parent may be NULL (devices/qpnp-*) or the spmi bus symlink.
genfscon sysfs /devices/qpnp-smbcharger                                  u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/qpnp-fg                                          u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /bus/spmi/devices/qpnp-smbcharger                         u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /bus/spmi/devices/qpnp-fg                                 u:object_r:sysfs_batteryinfo:s0


