# loc_launcher service
type location, domain;
type location_exec, exec_type, vendor_file_type, file_type;

# /data/misc/location is core_data_file_type (XTRA bin, mq, xtwifi).
typeattribute location data_between_core_and_vendor_violators;

init_daemon_domain(location)
net_domain(location)
wakelock_use(location)

binder_use(location)
binder_call(location, per_mgr)
binder_call(location, system_server)

qmux_socket(location)
allow location hal_wifi:unix_stream_socket { read write };

allow location location_data_file:dir rw_dir_perms;
allow location location_data_file:file create_file_perms;
allow location location_data_file:sock_file create_file_perms;
allow location location_exec:file x_file_perms;
allow location self:socket create_socket_perms;
allowxperm location self:socket ioctl msm_sock_ipc_ioctls;
allow location self:netlink_socket create_socket_perms_no_ioctl;
allow location self:netlink_route_socket create_socket_perms_no_ioctl;
allow location self:udp_socket create_socket_perms;
allowxperm location self:udp_socket ioctl { SIOCGIFINDEX SIOCGIFHWADDR SIOCIWFIRSTPRIV_05 };

# XTRA HTTPS 443 + SUPL TCP 7275 over Wi-Fi. SIOCGIFHWADDR is privileged.
allow location self:tcp_socket create_stream_socket_perms;
allow location port_type:tcp_socket name_connect;
allow location node_type:tcp_socket node_bind;
unix_socket_connect(location, dnsproxyd, netd)
unix_socket_connect(location, fwmarkd, netd)
allowxperm location self:tcp_socket ioctl { SIOCGIFINDEX SIOCGIFHWADDR SIOCGIFCONF SIOCGIFFLAGS SIOCGIFADDR };

# wlan0 + /proc/net for XTRA/SUPL path selection (RIL is P2).
r_dir_file(location, sysfs_wlan0)
r_dir_file(location, sysfs_net)
allow location proc_net:dir r_dir_perms;
allow location proc_net:file r_file_perms;

# create location socket location-mq-s
allow location location_data_file:sock_file { create setattr unlink };

# daemon starts as root to obtain all DAC capabilities
# TODO start as gps user and use filesystem-config to give
# proper DAC capabilities.
allow location self:capability { setuid setgid net_admin net_raw net_bind_service };
allow location self:capability2 wake_alarm;

# execute /vendor/bin/lowi-server and /vendor/bin/slim_daemon
allow location location_exec:file rx_file_perms;

# slim_daemon receives data from Loc_hal_worker
allow location self:socket create_socket_perms;

allow location vendor_file:dir r_dir_perms;

# loc_launcher (and children in this domain) read /vendor/etc/gps.conf.
allow location vendor_configs_file:dir search;
allow location gps_conf_file:file r_file_perms;

allow location sensorservice_service:service_manager find;

allow location sysfs_msm_subsys:dir { search read open };
allow location sysfs_msm_subsys:file rw_file_perms;
allow location sysfs_msm_subsys:lnk_file { read open };

# subsystem ramdump for debug builds
userdebug_or_eng(`
    allow location sysfs_msm_subsys:dir r_dir_perms;
    allow location sysfs_msm_subsys:lnk_file read;
')

allow location kernel:system { module_request };
