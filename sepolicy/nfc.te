# Talkman NXP PN547 (nq-nci). Node is /dev/pn547, labeled nfc_device.
# nfc_nci.msm8992.so dlopens /vendor/firmware/libpn547_fw.so
# (WOA nxppn547fw.dat). init.talkman.nfc.rc already chowns the node
# and symlinks /dev/pn54x. No FeliCa / snfc / Sony FW.

binder_call(nfc, nfc_hal_pn54x)

allow nfc nfc_device:chr_file rw_file_perms;

# libpn547_fw.so lives under /vendor/firmware (vendor_firmware_file).
# POST_INSTALL also links /system/vendor/firmware/libpn547_fw.so.
allow nfc vendor_firmware_file:dir r_dir_perms;
allow nfc vendor_firmware_file:file { read open getattr map execute };
allow nfc vendor_file:dir r_dir_perms;
allow nfc vendor_file:file { read open getattr map execute };

allow nfc nfc_data_file:dir create_dir_perms;
allow nfc nfc_data_file:{ file lnk_file fifo_file } create_file_perms;

allow nfc nfc_vendor_data_file:dir create_dir_perms;
allow nfc nfc_vendor_data_file:notdevfile_class_set create_file_perms;
