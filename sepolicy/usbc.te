# Talkman USB-C: Lattice iCE5LP2K CDONE + TI HD3SS460 mux.
# mmo-usbc.c DEVICE_ATTR(cdone) / DEVICE_ATTR(mux), both S_IRUGO.

type sysfs_ice5lp2k, fs_type, sysfs_type;
type sysfs_hd3ss460, fs_type, sysfs_type;

r_dir_file(shell, sysfs_ice5lp2k)
r_dir_file(shell, sysfs_hd3ss460)

r_dir_file(dumpstate, sysfs_ice5lp2k)
r_dir_file(dumpstate, sysfs_hd3ss460)
r_dir_file(hal_dumpstate_impl, sysfs_ice5lp2k)
r_dir_file(hal_dumpstate_impl, sysfs_hd3ss460)

allow init sysfs_ice5lp2k:dir r_dir_perms;
allow init sysfs_ice5lp2k:file { getattr setattr open read };
allow init sysfs_ice5lp2k:lnk_file r_file_perms;
allow init sysfs_hd3ss460:dir r_dir_perms;
allow init sysfs_hd3ss460:file { getattr setattr open read };
allow init sysfs_hd3ss460:lnk_file r_file_perms;

userdebug_or_eng(`
  r_dir_file(su, sysfs_ice5lp2k)
  r_dir_file(su, sysfs_hd3ss460)
')
