allow charger sysfs_thermal:dir r_dir_perms;
allow charger sysfs_thermal:file rw_file_perms;

# qpnp-smbcharger battery/dc + qpnp-fg bms. sysfs_batteryinfo is the
# Health 2.1 contract; sysfs_battery remains for any leftover vendor label.
allow charger sysfs_batteryinfo:dir r_dir_perms;
allow charger sysfs_batteryinfo:file rw_file_perms;
allow charger sysfs_batteryinfo:lnk_file r_file_perms;

allow charger sysfs_battery:dir r_dir_perms;
allow charger sysfs_battery:file rw_file_perms;
allow charger sysfs_battery:lnk_file r_file_perms;

# USB psy is under f9200000.ssusb until the power_supply prefix matches.
allow charger sysfs_usb:dir r_dir_perms;
allow charger sysfs_usb:file rw_file_perms;
allow charger sysfs_usb:lnk_file r_file_perms;
