// Real leftover: the QMI RIL blob /vendor/lib64/libril-qc-qmi-1.so imports
// android::AudioSystem::setErrorCallback(), which fw/av renamed to
// addErrorCallback() (fw/av 000c3e4). Without this, rild's dlopen() of the
// RIL fails, rild exits 1, and nothing votes the modem (MPSS) online.
cc_library {
    name: "libaudioclient_shim",
    srcs: ["libaudioclient_shim.cpp"],
    shared_libs: ["libaudioclient"],
    compile_multilib: "64",
    proprietary: true,
}
