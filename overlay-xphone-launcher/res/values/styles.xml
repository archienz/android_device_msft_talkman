     Literals only. Do not use ?attr/folderFillColor or other launcher-private
     references as values. Names from packages/apps/Trebuchet/res/values/styles.xml.

     BaseIcon.Workspace is the workspace / folder-icon label (app_icon.xml,
     folder_icon.xml). BaseIcon is all-apps / folder children.
     RRO style replace is whole-style; keep android: layout items.
     Dark* aliases keep light night-mode and DarkText off the white scrim.
-->
<resources>
    <style name="BaseIcon" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#ffe8e8e8</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textScaleX">0.78</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:shadowColor">#00000000</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <style name="BaseIcon.Workspace" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#ffe8e8e8</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textScaleX">0.78</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:shadowColor">#00000000</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <!-- Do not overlay LauncherTheme: stock parent is BaseLauncherTheme and
         items use Trebuchet-private attrs. Redeclaring those attrs in this
         RRO gets the wrong IDs and would drop the launcher theme chain.
         Dark LauncherTheme already voids allAppsScrimColor. Folder plate
         and labels are the live chrome. -->
</resources>
