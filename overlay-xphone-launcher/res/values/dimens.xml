     Names from packages/apps/Trebuchet/res/values/dimens.xml.
     bg_round_rect_radius is the open-folder plate (round_rect_folder).
     Stock 8dp; v28 folder used ?android:attr/dialogCornerRadius (squircle-ish).
-->
<resources>
    <dimen name="bg_round_rect_radius">4dp</dimen>
    <dimen name="default_dialog_corner_radius">4dp</dimen>
    <!-- Stock 4dp SF blur on the all-apps sheet. A418: skip it. -->
    <dimen name="all_apps_scrim_blur">0dp</dimen>
    <!-- Quickstep overview (packages/apps/Trebuchet/quickstep/res/values/dimens.xml). -->
    <dimen name="task_corner_radius_small">4dp</dimen>
    <dimen name="overview_actions_height">48dp</dimen>
    <!-- Folder children use this dimen, not the grid profile. -->
    <dimen name="folder_child_text_size">9sp</dimen>
    <dimen name="folder_label_text_size">9sp</dimen>
</resources>
