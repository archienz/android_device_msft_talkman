     Names from SystemUI res/values/dimens.xml and res-keyguard/values/dimens.xml.
     widget_big_font_size lives only in values-h650dp (not here): aapt2 drops
     identical values, and stock h650dp 54dp would then win on talkman (~726 dp).
-->
<resources>
    <dimen name="widget_label_font_size">13sp</dimen>
    <dimen name="widget_title_font_size">24dp</dimen>
    <!-- Slice-header clock; stock aliases this to 24dp which is too small. -->
    <dimen name="widget_small_font_size">48dp</dimen>
    <dimen name="bottom_text_spacing_digital">8dp</dimen>
    <dimen name="title_clock_padding">8dp</dimen>
    <dimen name="widget_vertical_padding_clock">4dp</dimen>

    <!-- Upper-third clock, not flush to the status bar. -->
    <dimen name="keyguard_clock_top_margin">88dp</dimen>

    <!-- Sit SWIPE UP above the 20 dp gestural handle. -->
    <dimen name="keyguard_indication_margin_bottom">56dp</dimen>

    <!-- No padlock: talkman has no FPC. Zero the lock glyph. -->
    <dimen name="keyguard_lock_width">0dp</dimen>
    <dimen name="keyguard_lock_height">0dp</dimen>
    <dimen name="keyguard_lock_padding">0dp</dimen>
    <dimen name="keyguard_clock_lock_margin">0dp</dimen>

    <dimen name="keyguard_shadow_radius">0</dimen>
</resources>
