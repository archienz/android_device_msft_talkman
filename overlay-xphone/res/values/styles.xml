     RRO must not reference SystemUI-private attrs/styles. Literals only.
     No ?attr/wallpaperTextColor. Keyguard* parents are @android:style/TextAppearance.
-->
<resources>
    <style name="widget_big">
        <item name="android:textSize">@dimen/widget_big_font_size</item>
        <item name="android:paddingBottom">@dimen/bottom_text_spacing_digital</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:ellipsize">none</item>
        <item name="android:shadowColor">#00000000</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <style name="widget_title_bold">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/widget_title_font_size</item>
        <item name="android:paddingBottom">@dimen/widget_vertical_padding_clock</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:ellipsize">none</item>
        <item name="android:shadowColor">#00000000</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <!-- Do not overlay TextAppearance.Keyguard. keyguard_status_area applies
         it as android:theme and still sets textColor=?attr/wallpaperTextColor.
         Replacing that style with a public android parent makes wallpaperTextColor
         unresolvable and KeyguardService crashes (black screen). -->

    <style name="TextAppearance.Keyguard.Secondary" parent="@android:style/TextAppearance">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lines">1</item>
        <item name="android:textSize">@dimen/widget_label_font_size</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">#ffe8e8e8</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:shadowColor">#00000000</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <style name="TextAppearance.Keyguard.BottomArea" parent="@android:style/TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#ffe8e8e8</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:shadowColor">#00000000</item>
        <item name="android:shadowRadius">0</item>
    </style>
</resources>
