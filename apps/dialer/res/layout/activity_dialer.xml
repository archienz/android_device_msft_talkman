<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff000000">

    <view
        class="com.talkman.ui.StarfieldView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_recents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:padding="16dp"
                android:text="@string/tab_recents"
                android:textAllCaps="true"
                android:textColor="#ffe8e8e8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:padding="16dp"
                android:text="@string/tab_contacts"
                android:textAllCaps="true"
                android:textColor="#66e8e8e8"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dial_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:minHeight="72dp"
            android:textColor="#ffe8e8e8"
            android:textSize="48dp"
            android:fontFeatureSettings="tnum" />

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#33ffffff"
            android:dividerHeight="1px"
            android:paddingLeft="24dp"
            android:paddingRight="24dp" />

        <GridLayout
            android:id="@+id/pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingBottom="8dp"
            android:useDefaultMargins="true" />

        <Button
            android:id="@+id/btn_call"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/call_hairline"
            android:text="☎"
            android:textColor="#ffe8e8e8"
            android:textSize="28sp" />
    </LinearLayout>
</FrameLayout>
