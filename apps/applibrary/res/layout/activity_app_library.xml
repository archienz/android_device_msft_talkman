<?xml version="1.0" encoding="utf-8"?>
<com.talkman.applibrary.PageSlideLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_slide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/search_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_height"
            android:layout_marginStart="@dimen/page_pad"
            android:layout_marginEnd="@dimen/page_pad"
            android:layout_marginTop="8dp"
            android:background="@drawable/search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text|textNoSuggestions"
                android:letterSpacing="0"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/folder_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/folder_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/page_pad"
                    android:paddingEnd="@dimen/page_pad"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <ScrollView
                android:id="@+id/app_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/page_pad"
                    android:paddingEnd="@dimen/page_pad"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0"
                        android:paddingBottom="12dp"
                        android:textColor="@color/ink"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/app_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</com.talkman.applibrary.PageSlideLayout>
