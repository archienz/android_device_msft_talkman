diff --git a/msm8994/common.mk b/msm8994/common.mk
index bbc2223111..351e1bc083 100644
--- a/msm8994/common.mk
+++ b/msm8994/common.mk
@@ -15,6 +15,14 @@ common_libs := liblog libutils libcutils libhardware
 #Common C flags
 common_flags := -DDEBUG_CALC_FPS -Wno-missing-field-initializers
 common_flags += -Wconversion -Wall -Werror
+# Clang r383902 (Android 11) treats CAF -Wconversion / GNU designators as errors.
+common_flags += -Wno-error=sign-conversion -Wno-error=conversion
+common_flags += -Wno-error=gnu-designator -Wno-gnu-designator
+common_flags += -Wno-error=unused-function -Wno-unused-function
+common_flags += -Wno-error=unused-parameter -Wno-error=unused-variable
+common_flags += -Wno-error=unused-const-variable -Wno-error=overloaded-virtual
+common_flags += -Wno-error=reorder -Wno-error=format -Wno-error=missing-braces
+common_flags += -Wno-error=unused-value -Wno-error=unused-label
 
 ifeq ($(TARGET_USES_POST_PROCESSING),true)
     common_flags     += -DUSES_POST_PROCESSING
