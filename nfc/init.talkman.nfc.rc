# NXP PN547 on I2C6 (WOA ACPI PNP0547). Kernel nq-nci node is /dev/pn547.
# IRQ/VEN/FWDN are TLMM 29/30/94 in nfc.dtsi — do not export them from init.
# nfc_nci.msm8992.so defaults to /dev/pn54x if NXP_NFC_DEV_NODE is rejected.
# Talkman has no eSE. Do not swap the chipset.

on boot
    chmod 0660 /dev/pn547
    chown nfc nfc /dev/pn547
    restorecon /dev/pn547
    symlink /dev/pn547 /dev/pn54x
    chmod 0660 /dev/pn54x
    chown nfc nfc /dev/pn54x
    setprop debug.nfc.fw_download true
    setprop debug.nfc.fw_boot_download false

# Android 11 host_init_verifier rejects '/' in trigger names, so
# `on device-added-/dev/pn547` cannot be used. Permissions for /dev/pn547
# are in ueventd.talkman.rc (0660 nfc nfc). The on boot stanza above
# creates the /dev/pn54x symlink the HAL still opens.

on post-fs-data
    mkdir /data/nfc 0770 nfc nfc
    mkdir /data/nfc/param 0770 nfc nfc
    mkdir /data/vendor/nfc 0770 nfc nfc
    restorecon_recursive /data/nfc
    restorecon_recursive /data/vendor/nfc
