// Optional WSI instance-extension probe. Not in PRODUCT_PACKAGES.
// Build with: m talkman-wsi-check
// Do not add this to talkman-vulkan.mk (other agent).

cc_binary {
    name: "talkman-wsi-check",
    srcs: ["wsi_check.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"TalkmanWsi\"",
    ],
}
