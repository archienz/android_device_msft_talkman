// Talkman on-device Vulkan HAL / loader probe (system binary).
// Installed via talkman-vulkan.mk PRODUCT_PACKAGES; do not add it here.
// VkCap.c / VkCap.h are optional; talkman-vk-probe stays on vk_probe.c only.

cc_binary {
    name: "talkman-vk-probe",
    srcs: ["vk_probe.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libdl",
        "libhardware",
        "libvulkan",
    ],

    header_libs: [
        "hwvulkan_headers",
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"TalkmanVk\"",
    ],
}

// Optional helper; not linked into talkman-vk-probe.
cc_library_static {
    name: "libtalkman-vkcap",
    srcs: ["VkCap.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "libdl",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    export_include_dirs: ["."],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// Optional on-device printer for libtalkman-vkcap; not linked into talkman-vk-probe.
cc_binary {
    name: "talkman-vk-cap",
    srcs: ["vk_cap_main.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    static_libs: [
        "libtalkman-vkcap",
    ],

    shared_libs: [
        "libdl",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
