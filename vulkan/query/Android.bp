// Talkman Vulkan 1.0 occlusion / timestamp query probe (system binary).
// Build with: m talkman-vk-query
// Not in PRODUCT_PACKAGES. Do not add this to talkman-vulkan.mk.
// Do not set ro.hwui.use_vulkan.

cc_binary {
    name: "talkman-vk-query",
    srcs: ["vk_query.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"TalkmanVkQuery\"",
    ],
}
