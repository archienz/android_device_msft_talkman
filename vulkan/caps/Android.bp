// Talkman Vulkan 1.0 physical-device capability dump (system binary).
// Build with: m talkman-vk-caps
// Not in PRODUCT_PACKAGES. Do not add this to talkman-vulkan.mk.
// Do not set ro.hwui.use_vulkan.

cc_binary {
    name: "talkman-vk-caps",
    srcs: ["vk_caps.c"],
    vendor: false,
    proprietary: false,
    compile_multilib: "64",

    shared_libs: [
        "liblog",
        "libvulkan",
    ],

    header_libs: [
        "vulkan_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"TalkmanVkCaps\"",
    ],
}
