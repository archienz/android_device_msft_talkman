<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>

    <!-- Vibration duration for MultiWaveView used in SearchPanelView -->
    <integer translatable="false" name="config_search_panel_view_vibration_duration">10</integer>

    <!--
         Duke is command-mode AMOLED (W10M Glance). Panel DT has on/off DCS
         only — no MDSS doze/ULPS AOD tables, no HWC STATE_DOZE. Not marlin.
    -->
    <bool name="doze_display_state_supported">false</bool>
    <bool name="doze_suspend_display_state_supported">false</bool>

    <!-- No nanohub TYPE_SIGNIFICANT_MOTION / TYPE_PICK_UP_GESTURE.
         leftover MATCH config_dozePulsePickup: pulse-on-pickup false. -->
    <bool name="doze_pulse_on_significant_motion">false</bool>
    <bool name="doze_pulse_on_pick_up">false</bool>
    <bool name="doze_pickup_performs_proximity_check">false</bool>

    <!-- QPDS-T900 TYPE_PROXIMITY is on the AP. Pulse is software screen-on, not AOD. -->
    <bool name="doze_proximity_check_before_pulse">true</bool>
    <bool name="doze_proximity_sensor_supported">true</bool>
    <bool name="doze_pulse_on_notifications">true</bool>

    <!-- Control whether status bar should distinguish HSPA data icon form UMTS
        data icon on devices -->
    <bool name="config_hspa_data_distinguishable">true</bool>

    <!-- Should "4G" be shown instead of "LTE" when the network is NETWORK_TYPE_LTE? -->
    <bool name="config_show4GForLTE">false</bool>

    <!-- leftover MATCH bullhead: recents is SystemUI overview on software
         navbar (config_hasRecents). No capacitive APP_SWITCH. No Dual SIM. -->

    <!-- leftover MATCH b045cc4: no FPC. Do not overlay
         config_fingerprintWakeAndUnlock (lineage-sdk / SystemUI default).
         No udfps, no in-screen FP icon. Settings 2fca2c7 owns face enroll. -->

    <!-- The default tiles to display in QuickSettings -->
    <string name="quick_settings_tiles_default" translatable="false">
        wifi,bt,nfc,rotation,location,cell,dnd,airplane,flashlight
    </string>
</resources>

