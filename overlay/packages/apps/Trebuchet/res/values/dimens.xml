<?xml version="1.0" encoding="utf-8"?>
<!--
     X-phone spacing on 1440×2560. Workspace page indicator stays a
     hairline (WorkspacePageIndicator), not Apple-scale dots.
     page_indicator_dot_size is folder pages only — keep it small.
-->
<resources>

    <dimen name="dynamic_grid_edge_margin">18dp</dimen>
    <dimen name="dynamic_grid_icon_drawable_padding">6dp</dimen>
    <dimen name="dynamic_grid_min_spring_loaded_space">12dp</dimen>

    <dimen name="dynamic_grid_cell_layout_padding">10dp</dimen>
    <dimen name="dynamic_grid_cell_padding_x">12dp</dimen>

    <!-- Thin dock -->
    <dimen name="dynamic_grid_hotseat_top_padding">4dp</dimen>
    <dimen name="dynamic_grid_hotseat_bottom_padding">4dp</dimen>
    <dimen name="dynamic_grid_hotseat_bottom_non_tall_padding">0dp</dimen>
    <dimen name="dynamic_grid_hotseat_extra_vertical_size">16dp</dimen>
    <dimen name="dynamic_grid_hotseat_side_padding">8dp</dimen>

    <!-- Hairline workspace pager, not iOS dots -->
    <dimen name="workspace_page_indicator_height">16dp</dimen>
    <dimen name="workspace_page_indicator_line_height">2dp</dimen>
    <dimen name="workspace_page_indicator_overlap_workspace">0dp</dimen>

    <dimen name="vertical_drag_handle_width">16dp</dimen>
    <dimen name="vertical_drag_handle_height">4dp</dimen>

    <!-- Folder chrome: tight, not colorful iOS tiles -->
    <dimen name="page_indicator_dot_size">6dp</dimen>
    <dimen name="folder_cell_x_padding">8dp</dimen>
    <dimen name="folder_cell_y_padding">6dp</dimen>
    <dimen name="folder_child_text_size">12sp</dimen>
    <dimen name="folder_label_padding_top">4dp</dimen>
    <dimen name="folder_label_padding_bottom">8dp</dimen>
    <dimen name="folder_label_text_size">13sp</dimen>
    <dimen name="bg_round_rect_radius">4dp</dimen>

</resources>
