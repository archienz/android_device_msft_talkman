<?xml version="1.0" encoding="utf-8"?>
<!--
     Force dark launcher chrome (black drawer, charcoal folders) even
     when system night mode is off. Themes.getActivityThemeRes still
     picks AppTheme vs AppTheme.Dark*; both now parent the Dark tree.

     Folder dots stay gray — not colorPrimary / iOS candy.
-->
<resources>

    <style name="AppTheme" parent="@style/LauncherTheme.Dark" />
    <style name="AppTheme.DarkMainColor" parent="@style/LauncherTheme.Dark.DarkMainColor" />
    <style name="AppTheme.DarkText" parent="@style/LauncherTheme.Dark.DarkText" />
    <style name="AppTheme.Dark" parent="@style/LauncherTheme.Dark" />
    <style name="AppTheme.Dark.DarkMainColor" parent="@style/LauncherTheme.Dark.DarkMainColor" />
    <style name="AppTheme.Dark.DarkText" parent="@style/LauncherTheme.Dark.DarkText" />

    <style name="LauncherTheme.Dark" parent="@style/LauncherTheme">
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFFFF</item>
        <item name="android:textColorTertiary">#CCFFFFFF</item>
        <item name="android:textColorHint">#A0FFFFFF</item>
        <item name="android:colorControlHighlight">#40FFFFFF</item>
        <item name="android:colorPrimary">#FF111111</item>
        <item name="allAppsScrimColor">#FF000000</item>
        <item name="allAppsInterimScrimAlpha">102</item>
        <item name="allAppsNavBarScrimColor">#80000000</item>
        <item name="allAppsTheme">@style/AllAppsTheme.Dark</item>
        <item name="popupColorPrimary">#FF1A1A1A</item>
        <item name="popupColorSecondary">#FF111111</item>
        <item name="popupColorTertiary">#FF3A3A3A</item>
        <item name="widgetsTheme">@style/WidgetContainerTheme.Dark</item>
        <item name="folderDotColor">#FF8A8A8A</item>
        <item name="folderFillColor">#F2101010</item>
        <item name="folderIconBorderColor">#FF2A2A2A</item>
        <item name="folderTextColor">@android:color/white</item>
        <item name="folderHintColor">#89AAAAAA</item>
        <item name="isMainColorDark">true</item>
        <item name="loadingIconColor">#99FFFFFF</item>
        <item name="iconOnlyShortcutColor">#B3FFFFFF</item>
        <item name="workProfileOverlayTextColor">@android:color/white</item>
        <item name="eduHalfSheetBGColor">#DD000000</item>
        <item name="workspaceTextColor">@android:color/white</item>
        <item name="isWorkspaceDarkText">false</item>
    </style>

    <style name="LauncherTheme.Dark.DarkMainColor" parent="@style/LauncherTheme.Dark">
        <item name="folderFillColor">#FF101010</item>
        <item name="folderTextColor">@android:color/white</item>
        <item name="disabledIconAlpha">.54</item>
    </style>

    <style name="LauncherTheme.Dark.DarkText" parent="@style/LauncherTheme.Dark">
        <item name="android:colorControlHighlight">#75212121</item>
        <item name="allAppsInterimScrimAlpha">25</item>
        <item name="folderFillColor">#F2101010</item>
        <item name="folderDotColor">#FF8A8A8A</item>
        <item name="folderIconBorderColor">#FF2A2A2A</item>
        <item name="folderTextColor">@android:color/white</item>
        <item name="workspaceTextColor">#FF212121</item>
        <item name="workspaceShadowColor">@android:color/transparent</item>
        <item name="workspaceAmbientShadowColor">@android:color/transparent</item>
        <item name="workspaceKeyShadowColor">@android:color/transparent</item>
        <item name="isWorkspaceDarkText">true</item>
        <item name="workspaceStatusBarScrim">@null</item>
    </style>

</resources>
