     Names from packages/apps/Settings/res/values/themes.xml.
     Literals only. Public android parents (live RRO, no Settings-private attrs).
     Theme.Settings is not replaced — it keeps preferenceTheme / wifi_signal.
-->
<resources>
    <style name="Theme.SettingsBase" parent="@android:style/Theme.DeviceDefault.Settings">
        <item name="android:windowBackground">#ff000000</item>
        <item name="android:colorBackground">#ff000000</item>
        <item name="android:colorPrimary">#ff000000</item>
        <item name="android:colorPrimaryDark">#ff000000</item>
        <item name="android:colorAccent">#ffe8e8e8</item>
        <item name="android:statusBarColor">#ff000000</item>
        <item name="android:navigationBarColor">#ff000000</item>
        <item name="android:navigationBarDividerColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">#ffe8e8e8</item>
        <item name="android:textColorSecondary">#99e8e8e8</item>
        <item name="android:textColorHint">#8ae8e8e8</item>
        <item name="android:textColorPrimaryInverse">#ffe8e8e8</item>
        <item name="android:colorControlNormal">#ffD6DEE8</item>
        <item name="android:colorControlActivated">#ffe8e8e8</item>
        <item name="android:colorControlHighlight">#33ffffff</item>
        <item name="android:listDivider">@drawable/xphone_list_divider</item>
        <item name="android:dividerHorizontal">@drawable/xphone_list_divider</item>
        <item name="android:dividerVertical">@drawable/xphone_list_divider</item>
        <!-- Preference titles (homepage + inner lists) use this. -->
        <item name="android:textAppearanceListItem">@style/TextAppearance.HomepageCardTitle</item>
    </style>

    <!-- Do not overlay Theme.Settings.Home: stock parent is HomeBase
         (preferenceTheme, search-bar ActionBar tint). Replacing that parent
         with a public android theme drops those items and breaks the
         homepage. Void cards/search/dialogs come from the color overlays;
         Theme.Settings inherits this SettingsBase. -->
</resources>
