     QSTileBaseView reads com.android.internal.R.dimen (android), not SystemUI.
     Stock -1dp = filled circle. 1dp = hairline ring (X-phone QS).
-->
<resources>
    <dimen name="config_qsTileStrokeWidthActive">1dp</dimen>
    <dimen name="config_qsTileStrokeWidthInactive">1dp</dimen>
    <!-- Light QS theme uses 0.26. getDisabled() then paints off tiles gone. -->
    <item name="disabled_alpha_material_light" format="float" type="dimen">1.0</item>
    <item name="disabled_alpha_material_dark" format="float" type="dimen">1.0</item>
</resources>
