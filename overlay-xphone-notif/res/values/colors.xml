     Names from frameworks/base/core/res/res/values/colors.xml.
     Invert the stock light template (dark text on #ffffffff).
-->
<resources>
    <color name="notification_material_background_color">#ff111111</color>
    <color name="notification_action_list">#ff1a1a1a</color>
    <color name="notification_primary_text_color_light">#ffe8e8e8</color>
    <color name="notification_secondary_text_color_light">#99e8e8e8</color>
    <color name="notification_progress_background_color">#33ffffff</color>
    <color name="notification_default_color_light">#ffe8e8e8</color>

    <!-- Stock accent is material_deep_teal. QS tiles read android.R.attr.colorAccent. -->
    <color name="accent_material_light">#ffe8e8e8</color>
    <color name="accent_material_dark">#ffe8e8e8</color>
    <color name="accent_device_default_light">#ffe8e8e8</color>
    <color name="accent_device_default_dark">#ffe8e8e8</color>
    <color name="accent_device_default">#ffe8e8e8</color>

    <!-- Theme.DeviceDefault.QuickSettings is Light. Inactive tiles read
         textColorSecondary / textColorTertiary = #8a000000. On a void shade
         that is invisible. Keep off tiles as visible ink like the mock. -->
    <color name="secondary_text_default_material_light">#ffe8e8e8</color>
    <color name="secondary_text_default_material_dark">#ffe8e8e8</color>
    <color name="primary_text_default_material_light">#ffe8e8e8</color>
    <color name="tertiary_text_dark">#ffe8e8e8</color>

    <!-- QSTileImpl active icon tint is colorPrimary = this on QuickSettings Light. -->
    <color name="primary_device_default_settings_light">#ffe8e8e8</color>
    <color name="primary_material_settings_light">#ffe8e8e8</color>
</resources>
