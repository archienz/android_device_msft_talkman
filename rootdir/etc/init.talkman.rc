import /vendor/etc/init/hw/init.talkman.usb.rc
import /vendor/etc/init/hw/init.talkman.diag.rc
import /vendor/etc/init/hw/init.talkman.ramdump.rc
import /vendor/etc/init/hw/init.talkman.misc.rc
import /vendor/etc/init/hw/init.talkman.sensors.rc
import /vendor/etc/init/hw/init.talkman.camera.rc
import /vendor/etc/init/hw/init.talkman.nfc.rc
import /vendor/etc/init/hw/init.talkman.gps.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug

    # Allow to access debugfs for system:system
    chmod 0755 /sys/kernel/debug
    chown system system /sys/kernel/debug/kgsl/proc

on charger
    # low power governing
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave

    # Disable CPU retention
    write /sys/module/lpm_levels/system/a53/cpu0/retention/idle_enabled 0
    write /sys/module/lpm_levels/system/a53/cpu1/retention/idle_enabled 0
    write /sys/module/lpm_levels/system/a53/cpu2/retention/idle_enabled 0
    write /sys/module/lpm_levels/system/a53/cpu3/retention/idle_enabled 0
    write /sys/module/lpm_levels/system/a57/cpu4/retention/idle_enabled 0
    write /sys/module/lpm_levels/system/a57/cpu5/retention/idle_enabled 0
    # Disable L2 retention
    write /sys/module/lpm_levels/system/a53/a53-l2-retention/idle_enabled 0
    write /sys/module/lpm_levels/system/a57/a57-l2-retention/idle_enabled 0

    # PMI8994 smbcharger off-mode: 5 V cable ceiling ~9 W, Qi DCIN 900 mA.
    # Kernel already asserted WC_EN. No PD / HVDCP path exists.
    write /sys/class/power_supply/usb/current_max 1800000
    write /sys/class/power_supply/dc/current_max 900000

    # Off-mode Health/charger: qpnp-fg (bms) + smbcharger (battery/usb/dc).
    chown system system /sys/class/power_supply/battery
    chown system system /sys/class/power_supply/bms
    chown system system /sys/class/power_supply/usb
    chown system system /sys/class/power_supply/dc
    chmod 0755 /sys/class/power_supply/battery
    chmod 0755 /sys/class/power_supply/bms
    chmod 0755 /sys/class/power_supply/usb
    chmod 0755 /sys/class/power_supply/dc
    chmod 0644 /sys/class/power_supply/battery/uevent
    chmod 0644 /sys/class/power_supply/battery/status
    chmod 0644 /sys/class/power_supply/battery/health
    chmod 0644 /sys/class/power_supply/battery/present
    chmod 0644 /sys/class/power_supply/battery/capacity
    chmod 0644 /sys/class/power_supply/battery/voltage_now
    chmod 0644 /sys/class/power_supply/battery/current_now
    chmod 0644 /sys/class/power_supply/battery/temp
    chmod 0644 /sys/class/power_supply/battery/charge_full
    chmod 0644 /sys/class/power_supply/battery/charge_full_design
    chmod 0644 /sys/class/power_supply/battery/charge_counter
    chmod 0644 /sys/class/power_supply/battery/cycle_count
    chmod 0644 /sys/class/power_supply/battery/technology
    chmod 0644 /sys/class/power_supply/battery/type
    chmod 0644 /sys/class/power_supply/bms/uevent
    chmod 0644 /sys/class/power_supply/bms/type
    chmod 0644 /sys/class/power_supply/bms/capacity
    chmod 0644 /sys/class/power_supply/bms/voltage_now
    chmod 0644 /sys/class/power_supply/bms/current_now
    chmod 0644 /sys/class/power_supply/bms/temp
    chmod 0644 /sys/class/power_supply/bms/battery_type
    chmod 0644 /sys/class/power_supply/bms/resistance_id
    chmod 0644 /sys/class/power_supply/bms/charge_full
    chmod 0644 /sys/class/power_supply/bms/charge_full_design
    chmod 0644 /sys/class/power_supply/bms/cycle_count
    chmod 0644 /sys/class/power_supply/usb/uevent
    chmod 0644 /sys/class/power_supply/usb/online
    chmod 0644 /sys/class/power_supply/usb/type
    chmod 0644 /sys/class/power_supply/usb/present
    chmod 0644 /sys/class/power_supply/dc/uevent
    chmod 0644 /sys/class/power_supply/dc/online
    chmod 0644 /sys/class/power_supply/dc/type
    chown system system /sys/class/power_supply/battery/charging_enabled
    chown system system /sys/class/power_supply/battery/battery_charging_enabled
    chown system system /sys/class/power_supply/battery/current_max
    chown system system /sys/class/power_supply/battery/input_current_max
    chown system system /sys/class/power_supply/battery/system_temp_level
    chown system system /sys/class/power_supply/usb/current_max
    chown system system /sys/class/power_supply/dc/current_max
    chmod 0664 /sys/class/power_supply/battery/charging_enabled
    chmod 0664 /sys/class/power_supply/battery/battery_charging_enabled
    chmod 0664 /sys/class/power_supply/battery/current_max
    chmod 0664 /sys/class/power_supply/battery/input_current_max
    chmod 0664 /sys/class/power_supply/battery/system_temp_level
    chmod 0664 /sys/class/power_supply/usb/current_max
    chmod 0664 /sys/class/power_supply/dc/current_max

    exec - root root -- /vendor/bin/init.talkman.charger.sh

    start thermal-engine
    start charger

on property:sys.boot_completed=1
    # allow CPUs to go in deeper idle state than C0
    write /sys/module/lpm_levels/parameters/sleep_disabled 0
    #end boot time fs tune
    write /sys/block/mmcblk0/queue/scheduler noop
    write /sys/block/mmcblk0/queue/rq_affinity 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 128
    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
    write /sys/block/dm-2/queue/read_ahead_kb 128
    write /sys/block/mmcblk0/queue/iostats 1

    start thermal-engine
    start loc_launcher
    start vendor.gnss_service
    start qcamerasvr
    start talkman-cci-perm
    restart cameraserver

on init

    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/max_comp_streams 4

    write /proc/sys/vm/page-cluster 0

    # Gadget is g_android (CONFIG_USB_G_ANDROID). init.talkman.usb.rc
    # owns adb/mtp. No CONFIG_USB_CONFIGFS, no PD PHY.
    setprop sys.usb.configfs 0

on fs
    mount_all /vendor/etc/fstab.talkman --early

    setprop sys.usb.ffs.aio_compat 1
    setprop persist.adb.nonblocking_ffs 0
    setprop ro.adb.nonblocking_ffs 0

    restorecon_recursive /persist

on late-fs
    # Start services for Boot Animation
    start servicemanager
    start surfaceflinger
    start bootanim
    # Mount RW partitions which need run fsck
    mount_all /vendor/etc/fstab.talkman --late
    swapon_all /vendor/etc/fstab.talkman

on early-boot
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864

    # Allow subsystem (modem etc) debugging
    write /sys/module/subsystem_restart/parameters/enable_debug ${persist.sys.ssr.enable_debug}
    write /sys/module/pil_msa/parameters/pbl_mba_boot_timeout_ms ${persist.sys.mba_boot_timeout}
    write /sys/module/pil_msa/parameters/modem_auth_timeout_ms ${persist.sys.modem_auth_timeout}
    write /sys/module/peripheral_loader/parameters/proxy_timeout_ms ${persist.sys.pil_proxy_timeout}

    # Update dm-verity state and set partition.*.verified properties
    verity_update_state

    # Busy loop to wait for devices booted by devstart_sh just in case device not ready
    exec - root root system -- /vendor/bin/init.qcom.devwait.sh

on boot
    # execute script to set initial CPU settings
    # don't run as a service to avoid race conditions
    exec - root root system -- /vendor/bin/init.talkman.power.sh

    # Qi ICL. USB ICL is set by smbcharger from detection (SDP 500 / DCP ≤ 1800).
    write /sys/class/power_supply/dc/current_max 900000

    # Health 2.1 / dumpstate: qpnp-fg bms + smbcharger battery/usb/dc.
    chown system system /sys/class/power_supply/battery
    chown system system /sys/class/power_supply/bms
    chown system system /sys/class/power_supply/usb
    chown system system /sys/class/power_supply/dc
    chmod 0755 /sys/class/power_supply/battery
    chmod 0755 /sys/class/power_supply/bms
    chmod 0755 /sys/class/power_supply/usb
    chmod 0755 /sys/class/power_supply/dc
    chmod 0644 /sys/class/power_supply/battery/uevent
    chmod 0644 /sys/class/power_supply/battery/status
    chmod 0644 /sys/class/power_supply/battery/health
    chmod 0644 /sys/class/power_supply/battery/present
    chmod 0644 /sys/class/power_supply/battery/capacity
    chmod 0644 /sys/class/power_supply/battery/voltage_now
    chmod 0644 /sys/class/power_supply/battery/current_now
    chmod 0644 /sys/class/power_supply/battery/temp
    chmod 0644 /sys/class/power_supply/battery/charge_full
    chmod 0644 /sys/class/power_supply/battery/charge_full_design
    chmod 0644 /sys/class/power_supply/battery/charge_counter
    chmod 0644 /sys/class/power_supply/battery/cycle_count
    chmod 0644 /sys/class/power_supply/battery/technology
    chmod 0644 /sys/class/power_supply/battery/type
    chmod 0644 /sys/class/power_supply/bms/uevent
    chmod 0644 /sys/class/power_supply/bms/type
    chmod 0644 /sys/class/power_supply/bms/capacity
    chmod 0644 /sys/class/power_supply/bms/voltage_now
    chmod 0644 /sys/class/power_supply/bms/current_now
    chmod 0644 /sys/class/power_supply/bms/temp
    chmod 0644 /sys/class/power_supply/bms/battery_type
    chmod 0644 /sys/class/power_supply/bms/resistance_id
    chmod 0644 /sys/class/power_supply/bms/charge_full
    chmod 0644 /sys/class/power_supply/bms/charge_full_design
    chmod 0644 /sys/class/power_supply/bms/cycle_count
    chmod 0644 /sys/class/power_supply/usb/uevent
    chmod 0644 /sys/class/power_supply/usb/online
    chmod 0644 /sys/class/power_supply/usb/type
    chmod 0644 /sys/class/power_supply/usb/present
    chmod 0644 /sys/class/power_supply/dc/uevent
    chmod 0644 /sys/class/power_supply/dc/online
    chmod 0644 /sys/class/power_supply/dc/type
    chown system system /sys/class/power_supply/battery/charging_enabled
    chown system system /sys/class/power_supply/battery/battery_charging_enabled
    chown system system /sys/class/power_supply/battery/current_max
    chown system system /sys/class/power_supply/battery/input_current_max
    chown system system /sys/class/power_supply/battery/system_temp_level
    chown system system /sys/class/power_supply/usb/current_max
    chown system system /sys/class/power_supply/dc/current_max
    chmod 0664 /sys/class/power_supply/battery/charging_enabled
    chmod 0664 /sys/class/power_supply/battery/battery_charging_enabled
    chmod 0664 /sys/class/power_supply/battery/current_max
    chmod 0664 /sys/class/power_supply/battery/input_current_max
    chmod 0664 /sys/class/power_supply/battery/system_temp_level
    chmod 0664 /sys/class/power_supply/usb/current_max
    chmod 0664 /sys/class/power_supply/dc/current_max

    # loc_eng / GNSS HIDL (user gps) and loc_launcher. Image is 0644; chmod
    # is a no-op on ro vendor/system if already set.
    chmod 0644 /vendor/etc/gps.conf
    chmod 0644 /system/etc/gps.conf
    chmod 0644 /vendor/etc/izat.conf
    chmod 0644 /vendor/etc/sap.conf
    chmod 0644 /vendor/etc/flp.conf
    chmod 0644 /vendor/etc/lowi.conf
    chmod 0644 /system/etc/thermal-engine-8992.conf
    chmod 0644 /vendor/etc/thermal-engine-8992.conf

    # thermal HAL reads zone 1/8-10/12-14 + xo_therm.
    chmod 0644 /sys/class/thermal/thermal_zone1/temp
    chmod 0644 /sys/class/thermal/thermal_zone8/temp
    chmod 0644 /sys/class/thermal/thermal_zone9/temp
    chmod 0644 /sys/class/thermal/thermal_zone10/temp
    chmod 0644 /sys/class/thermal/thermal_zone12/temp
    chmod 0644 /sys/class/thermal/thermal_zone13/temp
    chmod 0644 /sys/class/thermal/thermal_zone14/temp
    chmod 0644 /sys/class/hwmon/hwmon2/device/xo_therm
    chmod 0644 /sys/class/hwmon/hwmon2/device/emmc_therm
    chmod 0644 /sys/class/hwmon/hwmon2/device/msm_therm
    chmod 0644 /sys/class/hwmon/hwmon2/device/pa_therm0

    # mm-qcamera-daemon char nodes (ueventd also labels these).
    chown system camera /dev/video0
    chown system camera /dev/video1
    chown system camera /dev/media0
    chown system camera /dev/media1
    chown system camera /dev/jpeg0
    chown system camera /dev/v4l-subdev0
    chmod 0660 /dev/video0
    chmod 0660 /dev/video1
    chmod 0660 /dev/media0
    chmod 0660 /dev/media1
    chmod 0660 /dev/jpeg0
    chmod 0660 /dev/v4l-subdev0
    chown system camera /sys/class/leds/led:flash_0/brightness
    chown system camera /sys/class/leds/led:flash_1/brightness
    chown system camera /sys/class/leds/led:flash_torch/brightness
    chmod 0660 /sys/class/leds/led:flash_0/brightness
    chmod 0660 /sys/class/leds/led:flash_1/brightness
    chmod 0660 /sys/class/leds/led:flash_torch/brightness

    start thermal-engine
    start qcamerasvr

    # Perms only. Do not echo 1 (that would invent a slave-id in logs).
    chmod 0755 /sys/kernel/debug/talkman-cci-scan
    chmod 0660 /sys/kernel/debug/talkman-cci-scan/scan
    chown root shell /sys/kernel/debug/talkman-cci-scan
    chown root shell /sys/kernel/debug/talkman-cci-scan/scan

    # update foreground cpuset now that processors are up
    # foreground gets all CPUs except CPU 3
    # CPU 3 is reserved for the top app
    write /dev/cpuset/foreground/cpus 0-2,4-5
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-2
    write /dev/cpuset/restricted/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-5

    # Bluetooth
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt /dev/ttyHS0
    chmod 0660 /dev/ttyHS0
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/device/extldo
    chmod 0660 /sys/class/rfkill/rfkill0/device/extldo

    # create symlink for fb1 as HDMI
    symlink /dev/graphics/fb1 /dev/graphics/hdmi

    # setup permissions for fb1 related nodes
    chown system graphics /sys/class/graphics/fb1/hpd
    chown system graphics /sys/class/graphics/fb1/vendor_name
    chown system graphics /sys/class/graphics/fb1/product_description
    chmod 0664 /sys/devices/virtual/graphics/fb1/hpd
    chmod 0664 /sys/devices/virtual/graphics/fb1/vendor_name
    chmod 0664 /sys/devices/virtual/graphics/fb1/product_description

    # Grant permission to modify the color_temp setting
    chown system graphics /sys/class/graphics/fb0/color_temp
    chmod 0664 /sys/class/graphics/fb0/color_temp

    # Allow QMUX daemon to assign port open wait time
    chown radio radio /sys/devices/virtual/hsicctl/hsicctl0/modem_wait

    #Create QMUX deamon socket area
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /dev/socket/qmux_audio 0770 media audio
    chmod 2770 /dev/socket/qmux_audio
    mkdir /dev/socket/qmux_bluetooth 0770 bluetooth bluetooth
    chmod 2770 /dev/socket/qmux_bluetooth
    mkdir /dev/socket/qmux_gps 0770 gps gps
    chmod 2770 /dev/socket/qmux_gps
    mkdir /dev/socket/qmux_nfc 0770 nfc nfc
    chmod 2770 /dev/socket/qmux_nfc

    # Subsytem Restart
    write /sys/bus/msm_subsys/devices/subsys0/restart_level "related"
    write /sys/bus/msm_subsys/devices/subsys1/restart_level "related"
    write /sys/bus/msm_subsys/devices/subsys2/restart_level "related"
    write /sys/bus/msm_subsys/devices/subsys3/restart_level "related"

    # Subsytem Ramdump collection
    write /sys/module/subsystem_restart/parameters/enable_ramdumps 0
    write /sys/module/msm_poweroff/parameters/download_mode 0

    # Adjust socket buffer to enlarge TCP receive window for high bandwidth
    write /proc/sys/net/ipv4/tcp_adv_win_scale 1

    # Assign TCP buffer thresholds to be ceiling value of technology maximums
    # Increased technology maximums should be reflected here.
    write /proc/sys/net/core/rmem_max  8388608
    write /proc/sys/net/core/wmem_max  8388608

    # Wifi firmware reload path
    chown wifi wifi /sys/module/wlan/parameters/fwpath

    # Wifi firmware reload path
    chown wifi wifi /sys/module/wlan/parameters/fwpath

on post-fs
    symlink /dev/block/platform/soc.0/f9824900.sdhci /dev/block/bootdevice
    # CNSS loads qwlan30.bin from here (not /system, not bullhead paths).
    write /sys/module/firmware_class/parameters/path /vendor/firmware

    mkdir /persist/data 0700 system system
    mkdir /persist/data/sfs 0700 system system
    mkdir /persist/data/tz 0700 system system
    mkdir /persist/data/app_g 0700 system system
    mkdir /persist/widevine 0770 drm system
    mkdir /persist/camera 0770 camera camera
    # Standard Android wifi MAC persist file (installer: DPP/QCOM/WLAN.PROVISION).
    # Missing file is QCA OTP (g_use_otpmac=1). No baked address in the image.
    chmod 0644 /persist/wlan_mac.bin
    restorecon /persist/wlan_mac.bin

    start qseecomd
    # Busy loop to wait for qseecomd started
    exec - root root system -- /vendor/bin/init.talkman.qseecomd.sh
    # Start devices by sysfs trigger
    start devstart_sh

on post-fs
    # Allow writing to the kernel trace log.
    chmod 0222 /sys/kernel/debug/tracing/trace_marker
    chmod 0222 /sys/kernel/tracing/trace_marker

on post-fs-data
    # boot time fs tune
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/scheduler cfq
    write /sys/block/mmcblk0/queue/iosched/slice_idle 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/dm-0/queue/read_ahead_kb 2048
    write /sys/block/dm-1/queue/read_ahead_kb 2048
    write /sys/block/dm-2/queue/read_ahead_kb 2048

    # Mark the copy complete flag to not completed
    mkdir /data/misc/radio 0770 radio radio
    write /data/misc/radio/copy_complete 0
    chown radio radio /data/misc/radio/copy_complete
    chmod 0660 /data/misc/radio/copy_complete

    # Synaptics RMI4 @ 0x4b on BLSP1 QUP1 (i2c@f9923000). Firmware
    # SynaFWVendor1.img is requested at probe (synaptics,check-build).
    write /sys/devices/soc.0/f9923000.i2c/power/control on

    # Create the directories used by the Wireless subsystem
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

    # Create folder for WifiHal socket
    mkdir /dev/socket/wifihal 0770 wifi wifi
    chmod 2770 /dev/socket/wifihal

    # Create the directories used by CnE subsystem
    mkdir /data/connectivity 0771 system system

    # use qcril.db to handle Ecc and load MBN
    copy /system/etc/qcril.db /data/misc/radio/qcril.db
    chown radio radio /data/misc/radio/qcril.db
    chmod 0600 /data/misc/radio/qcril.db

    # Create folder for mm-qcamera-daemon
    mkdir /data/misc/camera 0770 camera camera
    mkdir /data/vendor/camera 0770 camera camera
    mkdir /persist/camera 0770 camera camera
    # No LDAF / VL6180 persist/calibration — talkman AF is VCM+OIS, not ToF.

    #Create directories for Location services
    mkdir /data/misc/location 0770 gps gps
    mkdir /data/misc/location/mq 0770 gps gps
    mkdir /data/misc/location/xtwifi 0770 gps gps
    mkdir /data/misc/location/gpsone_d 0770 system gps
    mkdir /data/vendor/location 0770 gps gps
    chmod 0644 /vendor/etc/gps.conf
    chmod 0644 /system/etc/gps.conf
    chmod 0644 /vendor/etc/izat.conf
    chmod 0644 /vendor/etc/sap.conf
    chmod 0644 /vendor/etc/flp.conf
    chmod 0644 /vendor/etc/lowi.conf

    # Audio
    mkdir /data/misc/audio 0770 audio audio

    # perf daemon
    mkdir /data/misc/perfd 0755 root system
    chmod 2755 /data/misc/perfd
    rm /data/misc/perfd/default_values


    # Create directory used by sensor subsystem
    mkdir /persist/sensors 0775 system root
    chmod 0664 /persist/sensors/sensors_settings
    chown system root /persist/sensors/sensors_settings
    mkdir /data/misc/sensors 0775 system system
    restorecon_recursive /data/misc/sensors

    mkdir /sns/cal/ 0644 system system
    restorecon_recursive /sns

    # Subsytem Ramdump collection
    mkdir /data/ramdump 0700 root root

    setprop vold.post_fs_data_done 1

service irsc_util /vendor/bin/irsc_util "/etc/sec_config"
    class main
    user root
    oneshot

service rmt_storage /vendor/bin/rmt_storage
    class core
    user root
    group system wakelock
    shutdown critical

service start_hci_filter /vendor/bin/wcnss_filter
    class late_start
    user bluetooth
    group bluetooth system
    disabled

on property:wc_transport.start_hci=true
    start start_hci_filter

on property:wc_transport.start_hci=false
    stop start_hci_filter

# QMUX must be in multiple groups to support external process connections
service qmuxd /vendor/bin/qmuxd
    class main
    user root
    group radio audio bluetooth wakelock gps nfc

service perfd /vendor/bin/perfd
    class main
    user root
    group system
    writepid /dev/cpuset/system-background/tasks

service qti /vendor/bin/qti
    class main
    user radio
    group radio net_raw diag usb net_admin

# Talkman uses sensors.talkman (AP I2C HAL). Do not start sensors.qcom / nanohub.

service netmgrd /vendor/bin/netmgrd
    class main
    group radio system wakelock

service per_mgr /vendor/bin/pm-service
    class core
    user system
    group system net_raw

service per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system net_raw
    disabled

on property:init.svc.per_mgr=running
    start per_proxy

on property:sys.shutdown.requested=*
    stop per_proxy

# Talkman retail SKUs (not Nexus 5X LGH79x). RM-1105 is the US unit.
on property:ro.boot.hardware.sku=RM-1105
    setprop ro.boot.wificountrycode US

on property:ro.boot.hardware.sku=RM-1104
    setprop ro.boot.wificountrycode 00

on property:ro.boot.hardware.sku=RM-1108
    setprop ro.boot.wificountrycode 00

service thermal-engine /vendor/bin/thermal-engine -c /vendor/etc/thermal-engine-8992.conf
    class main
    user root
    socket thermal-send-client stream 0660 system system
    socket thermal-recv-client stream 0660 system system
    socket thermal-recv-passive-client stream 0660 system system
    group root radio system

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    class late_start

service qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root

service msm_irqbalance /vendor/bin/msm_irqbalance -f /vendor/etc/msm_irqbalance.conf
    socket msm_irqbalance seqpacket 660 root system
    class core
    user root
    group root
    writepid /dev/cpuset/system-background/tasks

service charger /charger
    class charger
    critical
    seclabel u:r:charger:s0

service qcamerasvr /vendor/bin/mm-qcamera-daemon
    class main
    user camera
    group camera system inet input graphics
    writepid /dev/cpuset/system-background/tasks

# chmod debugfs only. Never write scan / slave-id (CCI SID unknown).
service talkman-cci-perm /vendor/bin/sh -c "chmod 0755 /sys/kernel/debug/talkman-cci-scan; chmod 0660 /sys/kernel/debug/talkman-cci-scan/scan; chown root:shell /sys/kernel/debug/talkman-cci-scan /sys/kernel/debug/talkman-cci-scan/scan"
    class late_start
    user root
    group root shell
    oneshot

on property:persist.radio.atfwd.start=false
    stop atfwd

service atfwd /vendor/bin/ATFWD-daemon
    class late_start
    user system
    group system radio

#on property:ro.debuggable=1
#    start ss_ramdump

service ss_ramdump /vendor/bin/subsystem_ramdump
    class main
    user root
    group root system
    disabled

service cnd /vendor/bin/cnd
    class late_start
    socket cnd stream 660 root inet
    group root wakelock

service imsqmidaemon /vendor/bin/imsqmidaemon
    class main
    user system
    socket ims_qmid stream 0660 system radio
    group radio net_raw log diag

service imsdatadaemon /vendor/bin/imsdatadaemon
    class main
    user system
    socket ims_datad stream 0660 system radio
    group system wifi radio inet net_raw log diag net_admin
    disabled

on property:sys.ims.QMI_DAEMON_STATUS=1
    start imsdatadaemon

service talkman-sh /vendor/bin/init.talkman.sh
    class late_start
    user radio
    group system
    oneshot

# bugreport is triggered by holding down volume down, volume up and power
service bugreport /vendor/bin/dumpstate -d -p -B -z \
        -o /data/user_de/0/com.android.shell/files/bugreports/bugreport
    class main
    disabled
    oneshot

service devstart_sh /vendor/bin/init.qcom.devstart.sh
    class main
    user root
    group root system
    disabled
    oneshot

on property:apexd.status=ready
    mount none /system/etc/swcodec/ld.config.txt /apex/com.android.media.swcodec/etc/ld.config.txt bind

on property:init.svc.media=restarting
    restart qcamerasvr

on property:init.svc.servicemanager=restarting
    restart qcamerasvr
    
on property:vold.decrypt=trigger_restart_framework
    restart camera-provider-2-4

# LGE/bullhead ADSP sensor bringup (init.msm8992.sensor.sh) is not used.