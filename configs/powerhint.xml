<?xml version="1.0" encoding="utf-8"?>
<!--
  Talkman MSM8992 (4x Cortex-A53 + 2x Cortex-A57).

  OPP tables: kernel msm8992.dtsi
    qcom,cpufreq-table-0 (LITTLE / cpu0)
    qcom,cpufreq-table-4 (big / cpu4)
    qcom,a57-speedbin0-v0 tops at 1824000000 Hz
    qcom,vdd-apps-rstr levels 768000 / 1248000 / 1824000

  A57 ceiling is 1824000 kHz. Do not add 1960000 (WOA PEP overclock).
  GPU pwrlevels: msm8992-gpu.dtsi (0=600MHz .. 5=180MHz, 6=27MHz).
  Input boost matches init.talkman.power.sh (0:960000, 40 ms).
-->
<HintConfigs platform="msm8992">
  <Opp cluster="little" policy_cpu="0">
    <Freq khz="384000"/>
    <Freq khz="460800"/>
    <Freq khz="600000"/>
    <Freq khz="672000"/>
    <Freq khz="787200"/>
    <Freq khz="864000"/>
    <Freq khz="960000"/>
    <Freq khz="1248000"/>
    <Freq khz="1440000"/>
  </Opp>
  <Opp cluster="big" policy_cpu="4">
    <Freq khz="384000"/>
    <Freq khz="480000"/>
    <Freq khz="633600"/>
    <Freq khz="768000"/>
    <Freq khz="864000"/>
    <Freq khz="960000"/>
    <Freq khz="1248000"/>
    <Freq khz="1344000"/>
    <Freq khz="1440000"/>
    <Freq khz="1536000"/>
    <Freq khz="1632000"/>
    <Freq khz="1689600"/>
    <Freq khz="1824000"/>
  </Opp>

  <Defaults>
    <Little min_khz="384000" hispeed_khz="960000"/>
    <Big min_khz="384000" hispeed_khz="1248000" max_khz="1824000"/>
    <Gpu min_pwrlevel="5" max_pwrlevel="0" default_pwrlevel="5"/>
    <InputBoost freq="0:960000 4:0" ms="40"/>
  </Defaults>

  <Hint name="INTERACTION" duration_ms="1500">
    <Little min_khz="960000"/>
  </Hint>

  <Hint name="LAUNCH" duration_ms="2000">
    <Little min_khz="960000"/>
    <Big min_khz="1248000"/>
    <Gpu max_pwrlevel="0"/>
    <InputBoost freq="0:960000 4:1248000" ms="2000"/>
  </Hint>

  <Hint name="VIDEO_ENCODE">
    <Little hispeed_khz="768000"/>
    <Big hispeed_khz="1248000"/>
  </Hint>

  <Hint name="LOW_POWER">
    <Little max_khz="960000"/>
    <Big max_khz="768000"/>
    <Gpu max_pwrlevel="5"/>
  </Hint>

  <Hint name="SUSTAINED_PERFORMANCE">
    <Big max_khz="1248000"/>
    <Gpu max_pwrlevel="1"/>
  </Hint>

  <Hint name="VR_MODE">
    <Big min_khz="1248000" max_khz="1248000"/>
    <Gpu max_pwrlevel="1"/>
  </Hint>

  <Hint name="INTERACTIVE_OFF">
    <Little min_khz="384000"/>
    <Big min_khz="384000"/>
    <InputBoost freq="0:960000 4:0" ms="40"/>
  </Hint>
</HintConfigs>
