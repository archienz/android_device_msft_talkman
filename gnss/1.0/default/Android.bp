// Talkman copy of hardware/interfaces/gnss/1.0/default.
// nmeaCb ignores CAF's off-by-one length so hidl_string does not abort.
// Stem/overrides stock android.hardware.gnss@1.0-impl. VINTF is not on
// this module (device vintf/android.hardware.gnss@1.0.xml).
cc_library_shared {
    name: "android.hardware.gnss@1.0-impl.talkman",
    stem: "android.hardware.gnss@1.0-impl",
    overrides: ["android.hardware.gnss@1.0-impl"],
    defaults: ["hidl_defaults"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "ThreadCreationWrapper.cpp",
        "AGnss.cpp",
        "AGnssRil.cpp",
        "Gnss.cpp",
        "GnssBatching.cpp",
        "GnssDebug.cpp",
        "GnssGeofencing.cpp",
        "GnssMeasurement.cpp",
        "GnssNavigationMessage.cpp",
        "GnssNi.cpp",
        "GnssXtra.cpp",
        "GnssConfiguration.cpp",
        "GnssUtils.cpp",
    ],
    shared_libs: [
        "liblog",
        "libhidlbase",
        "libutils",
        "android.hardware.gnss@1.0",
        "libhardware",
    ],
}
